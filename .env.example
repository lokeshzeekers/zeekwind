# Copied to .env by scripts/setup.sh (the __X__ markers are replaced with random secrets).
POSTGRES_PASSWORD=__PG__
JWT_SECRET=__JWT__
MQTT_SERVER_PASSWORD=__MQ__
APP_TIMEZONE=Asia/Kolkata
OFFLINE_AFTER_SECONDS=30
# kg of CO2 avoided per kWh of solar energy (grid emission factor; 0.82 is the usual figure for India)
CO2_KG_PER_KWH=0.82
