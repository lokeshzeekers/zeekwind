# Created from this template by scripts/setup.sh (secrets are generated for you)
POSTGRES_PASSWORD=__PG__
JWT_SECRET=__JWT__
MQTT_SERVER_PASSWORD=__MQ__
# Days in the daily reports/history are cut at midnight in this timezone. CHANGE to your site's timezone.
APP_TIMEZONE=Asia/Kolkata
# Turbine is shown OFFLINE when no data arrives for this many seconds (data is sent every 3-5 s)
OFFLINE_AFTER_SECONDS=30
